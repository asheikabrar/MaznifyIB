# Copy this file to .env and fill in real values
# Use either ANTHROPIC_API_KEY or COAGENT_ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=your-anthropic-key-here
# COAGENT_ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
DATABASE_URL=sqlite:///./data/studymate.db
APP_TIMEZONE=Asia/Dubai
# Optional: set a strong secret and admin credentials for local or deployed use
# APP_SECRET=replace-with-a-long-random-secret
# STUDYMATE_ADMIN_USERNAME=admin
# STUDYMATE_ADMIN_PASSWORD=replace-with-a-strong-password
