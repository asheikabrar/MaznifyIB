# Copy this file to .env and fill in real values
# Use either ANTHROPIC_API_KEY or COAGENT_ANTHROPIC_API_KEY

# AI Model
ANTHROPIC_API_KEY=your-anthropic-key-here
# COAGENT_ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# LOCAL (development):
#   DATABASE_URL=sqlite:///./data/studymate.db
#
# PRODUCTION (Vercel/cloud):
#   DATABASE_URL=postgresql://user:password@host/dbname
#   (Get a free Postgres from Neon: https://neon.tech)
# ============================================================
DATABASE_URL=sqlite:///./data/studymate.db

# Timezone (adjust to your timezone)
APP_TIMEZONE=Asia/Dubai

# Optional: Security
# APP_SECRET=replace-with-a-long-random-secret (recommended for production)
# STUDYMATE_ADMIN_USERNAME=admin
# STUDYMATE_ADMIN_PASSWORD=replace-with-a-strong-password

